# Copy to .env and adjust. .env is gitignored — never commit real secrets or data paths.

# --- Data locations (defaults point at the committed synthetic sample) ---
# Point PLS_RAW_DIR at your local Novartis PDF corpus to run real ingestion.
# PLS_RAW_DIR=/absolute/path/to/ClinicalTrials_Dataset
# PLS_INTERIM_DIR=data/interim
# PLS_PROCESSED_DIR=data/processed

# --- Reproducibility ---
PLS_SEED=42

# --- Device: auto | cpu | cuda | mps (auto = CPU-first, GPU if available) ---
PLS_DEVICE=auto

# --- Model identifiers (override to try alternatives) ---
# PLS_EXTRACTIVE_MODEL=distilbert-base-uncased
# PLS_GENERATIVE_MODEL=mistralai/Mistral-7B-Instruct-v0.1

# --- Hosted-provider API keys (used only in later milestones; never logged) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
